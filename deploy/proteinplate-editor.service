[Unit]
Description=Protein Plate — the editing page
Documentation=file:///home/simon/Development/protein-plate/EDITING.md
After=network-online.target
Wants=network-online.target

[Service]
User=simon
WorkingDirectory=/home/simon/Development/protein-plate
# systemd does not set HOME for system services, and git needs it for commits.
Environment=HOME=/home/simon
Environment=EDITOR_PORT=9003
ExecStart=/home/simon/Development/protein-plate/.venv/bin/python editor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
